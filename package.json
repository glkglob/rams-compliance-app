{
  "name": "rams-compliance-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "npx dotenv-cli -e .env.development.local -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc --noEmit",
    "validate": "npm run lint && npm run type-check && npm run test",
    "// Supabase local/remote helpers": "",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:diff:local": "supabase db diff",
    "db:diff:remote": "supabase db diff --linked",
    "db:sync:local-to-remote": "echo '⚠️  This will push local migrations to remote. Make sure you have the correct remote linked.' && supabase db push --linked --yes",
    "supabase:switch:local": "npx tsx scripts/switch-supabase.ts local",
    "supabase:switch:remote": "npx tsx scripts/switch-supabase.ts remote",
    "supabase:mode": "npx tsx scripts/switch-supabase.ts status",
    "// Docker (optimized for Railway + Docker Hub)": "",
    "// NOTE: NEXT_PUBLIC_* vars must be passed as build args because Next.js inlines them at build time.": "",
    "docker:build": "docker build --platform linux/amd64 --build-arg NEXT_PUBLIC_SUPABASE_URL=\"$NEXT_PUBLIC_SUPABASE_URL\" --build-arg NEXT_PUBLIC_SUPABASE_ANON_KEY=\"$NEXT_PUBLIC_SUPABASE_ANON_KEY\" --build-arg NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=\"$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY\" --build-arg NEXT_PUBLIC_SENTRY_DSN=\"$NEXT_PUBLIC_SENTRY_DSN\" -t rams-compliance-app .",
    "docker:build:clean": "docker build --no-cache --platform linux/amd64 --build-arg NEXT_PUBLIC_SUPABASE_URL=\"$NEXT_PUBLIC_SUPABASE_URL\" --build-arg NEXT_PUBLIC_SUPABASE_ANON_KEY=\"$NEXT_PUBLIC_SUPABASE_ANON_KEY\" --build-arg NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=\"$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY\" --build-arg NEXT_PUBLIC_SENTRY_DSN=\"$NEXT_PUBLIC_SENTRY_DSN\" -t rams-compliance-app .",
    "docker:build:hub": "docker build --platform linux/amd64 --build-arg NEXT_PUBLIC_SUPABASE_URL=\"$NEXT_PUBLIC_SUPABASE_URL\" --build-arg NEXT_PUBLIC_SUPABASE_ANON_KEY=\"$NEXT_PUBLIC_SUPABASE_ANON_KEY\" --build-arg NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=\"$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY\" --build-arg NEXT_PUBLIC_SENTRY_DSN=\"$NEXT_PUBLIC_SENTRY_DSN\" -t k1dev2026/rams-compliance-app:latest .",
    "docker:build:clean:hub": "docker build --no-cache --platform linux/amd64 --build-arg NEXT_PUBLIC_SUPABASE_URL=\"$NEXT_PUBLIC_SUPABASE_URL\" --build-arg NEXT_PUBLIC_SUPABASE_ANON_KEY=\"$NEXT_PUBLIC_SUPABASE_ANON_KEY\" --build-arg NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=\"$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY\" --build-arg NEXT_PUBLIC_SENTRY_DSN=\"$NEXT_PUBLIC_SENTRY_DSN\" -t k1dev2026/rams-compliance-app:latest .",
    "docker:push": "docker push k1dev2026/rams-compliance-app:latest",
    "docker:build:push": "npm run docker:build:hub && npm run docker:push",
    "docker:run": "docker run -p 3000:3000 --env-file .env.local rams-compliance-app",
    "docker:run:prod": "docker run -p 3000:3000 k1dev2026/rams-compliance-app:latest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.54.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@upstash/qstash": "^2.11.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "next": "16.2.6",
    "openai": "^6.39.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.77.0",
    "resend": "^6.12.4",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.7",
    "dotenv-cli": "^7.4.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.0"
    }
  }
}
