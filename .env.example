# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://gfykygieoxattypakrwa.supabase.co

# New recommended public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Legacy anon key (still supported as fallback)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only key (never expose this)
SUPABASE_SERVICE_ROLE_KEY=eyJ... (or new sb_secret_... key)

# Database (Supabase direct connection — used for migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# OpenAI
OPENAI_API_KEY=sk-...

# Resend (transactional email)
RESEND_API_KEY=re_...
# Verified "from" address used by sendEmail(); if unset, email sending degrades gracefully.
RESEND_FROM_EMAIL=no-reply@yourdomain.com

# Runtime (set automatically by Railway; set to "development" locally)
NODE_ENV=development

# Sentry — error tracking and performance monitoring
# Create a project at https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
# Required for source map upload during `npm run build` (set in Railway build vars)
SENTRY_AUTH_TOKEN=your-auth-token

# Upstash Redis — for per-user AI endpoint rate limiting
# Create a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Rate limit overrides (optional — defaults shown below)
# RATE_LIMIT_REVIEW=10          # reviews per user per hour
# RATE_LIMIT_EMAIL=20           # email generations per user per hour
# RATE_LIMIT_REQUIREMENTS=5     # requirement extractions per user per hour

# Upstash QStash — async document processing queue
# Create a queue at https://console.upstash.com/qstash (copy the token + signing keys)
QSTASH_TOKEN=eyJ...
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...

# Shared secret allowing the /api/process-document worker to be triggered
# without a QStash signature (manual re-processing / cron). Use a long random string.
CRON_SECRET=replace-with-a-long-random-string

# Public base URL of this app, used as the QStash callback target.
# On Railway this is auto-derived from RAILWAY_PUBLIC_DOMAIN if unset.
APP_URL=https://https://www.rams-compliance.com

# Railway — set in Railway dashboard, not here
# NODE_OPTIONS=--max-old-space-size=4096
