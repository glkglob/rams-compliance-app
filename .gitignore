# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files — NEVER commit real secrets
# .env and .env.local (and variants) must stay out of Git and Docker images
.env*
# Only the safe example templates are allowed
!.env.example
!.env.test.local.example

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
supabase/.branches/
supabase/.temp/

# playwright
playwright-report/
test-results/

# (Sentry build plugin env is already covered by the .env* rule above)

# Tesseract OCR training data (downloaded at build/runtime)
*.traineddata
.windsurf/

# IDE
.idea/
.vscode/

# Local Claude/AI session caches (team tooling stays tracked; sessions don't)
.claude/sessions/
# Supabase local development artifacts (config.toml can hold local port/db overrides)
supabase/.branches/
supabase/.temp/
supabase/snippets/
supabase/config.toml
# The .gitignore inside supabase/ is for local CLI temp files
supabase/.gitignore
