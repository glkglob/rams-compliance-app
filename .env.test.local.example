# E2E test environment template
# ------------------------------
# Copy to `.env.test.local` and fill in values for E2E runs that need to hit
# real services. Anything left blank here falls back to Playwright's built-in
# safe placeholders (see playwright.config.ts) which let the dev server boot
# but cannot actually authenticate against Supabase / call external APIs.
#
# `.env.test.local` is git-ignored (matches `.env*` in .gitignore).
#
# Recommended local setup for full E2E:
#   1. `npm run supabase:start` to boot a local Supabase instance.
#   2. Copy the local anon key into NEXT_PUBLIC_SUPABASE_ANON_KEY.
#   3. Copy the local service-role key into SUPABASE_SERVICE_ROLE_KEY.
#   4. Run `npm run test:e2e`.

# Set by Playwright automatically — listed here for visibility.
# NODE_ENV=test
# E2E=true

# Supabase (point at your LOCAL supabase if you have one running)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (local supabase Postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# AI / email — placeholder is fine if tests don't actually call these
OPENAI_API_KEY=
RESEND_API_KEY=

# Optional — leave blank to disable
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CRON_SECRET=
APP_URL=http://localhost:3000
